{
  "name": "supportai-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute supportai-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute supportai-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wrangler": "^3.99.0"
  }
}